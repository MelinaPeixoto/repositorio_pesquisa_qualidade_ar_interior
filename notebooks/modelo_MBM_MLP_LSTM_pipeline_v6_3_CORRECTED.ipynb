    "# =========================\n",
    "# 3) CORRECTED: Features com melhor tratamento de NaN\n",
    "# =========================\n",
    "\n",
    "def build_features(df: pd.DataFrame, cout_col: str, extra_cols: Optional[List[str]], hour_col: Optional[str]) -> Tuple[np.ndarray, List[str]]:\n",
    "    \"\"\"\n",
    "    Retorna X(t) com colunas: Cout, extras (se existirem), hour_sin, hour_cos (se disponíveis)\n",
    "    CORRECTED: Validação de colunas existentes\n",
    "    \"\"\"\n",
    "    cols = []\n",
    "    names = []\n",
    "\n",
    "    if cout_col in df.columns:\n",
    "        cols.append(df[cout_col].astype(float).values.reshape(-1,1))\n",
    "        names.append(\"Cout\")\n",
    "    else:\n",
    "        raise ValueError(f\"Column {cout_col} not found in dataframe\")\n",
    "\n",
    "    if extra_cols:\n",
    "        for c in extra_cols:\n",
    "            if c in df.columns:\n",
    "                cols.append(df[c].astype(float).values.reshape(-1,1))\n",
    "                names.append(c)\n",
    "\n",
    "    if hour_col is not None and \"hour_sin\" in df.columns and \"hour_cos\" in df.columns:\n",
    "        cols.append(df[\"hour_sin\"].astype(float).values.reshape(-1,1))\n",
    "        names.append(\"hour_sin\")\n",
    "        cols.append(df[\"hour_cos\"].astype(float).values.reshape(-1,1))\n",
    "        names.append(\"hour_cos\")\n",
    "\n",
    "    X = np.hstack(cols)\n",
    "    return X, names\n",
    "\n",
    "\n",
    "def standardize_train_apply(X_train: np.ndarray, X_apply: np.ndarray):\n",
    "    \"\"\"\n",
    "    Padroniza dados preservando estrutura temporal.\n",
    "    CORRECTED: Imputation de NaN antes da padronização para evitar propagação\n",
    "    \"\"\"\n",
    "    X_train = np.asarray(X_train, float).copy()\n",
    "    X_apply = np.asarray(X_apply, float).copy()\n",
    "    \n",
    "    # Imputa NaN na coluna com a mediana por coluna\n",
    "    for j in range(X_train.shape[1]):\n",
    "        valid_idx = np.isfinite(X_train[:, j])\n",
    "        if valid_idx.sum() > 0:\n",
    "            median_val = np.nanmedian(X_train[valid_idx, j])\n",
    "            X_train[~valid_idx, j] = median_val\n",
    "            # Aplica mesma imputação em X_apply\n",
    "            X_apply[~np.isfinite(X_apply[:, j]), j] = median_val\n",
    "    \n",
    "    # Calcula estatísticas APENAS em dados válidos de treino\n",
    "    mu = np.nanmean(X_train, axis=0)\n",
    "    sd = np.nanstd(X_train, axis=0)\n",
    "    sd[sd == 0] = 1.0\n",
    "    \n",
    "    X_train_s = (X_train - mu) / sd\n",
    "    X_apply_s = (X_apply - mu) / sd\n",
    "    \n",
    "    return X_train_s, X_apply_s, mu, sd\n",
    "\n",
    "print(\"✓ Feature functions loaded\")"
   ]
