    "# =========================\n",
    "# 4) CORRECTED: MBM baseline com indexação temporal corrigida\n",
    "# =========================\n",
    "\n",
    "def estimate_params_linear(cin: np.ndarray, cout: np.ndarray, dt: float = 1.0) -> Tuple[float, float]:\n",
    "    \"\"\"\n",
    "    Ajuste linear para MBM discreto: cin(t) = a*cin(t-1) + b*cout(t)\n",
    "    então: k = -ln(a)/dt, Finf = b/(1-a)\n",
    "    \n",
    "    CORRECTED: \n",
    "    - Indexação temporal corrigida: cin(t-1), cout(t), cin(t) alinhados\n",
    "    - Validação de decaimento: enforça 0 < a < 1 (physical constraint)\n",
    "    \"\"\"\n",
    "    cin = np.asarray(cin, float)\n",
    "    cout = np.asarray(cout, float)\n",
    "    \n",
    "    if len(cin) < 2 or len(cout) < 2:\n",
    "        return np.nan, np.nan\n",
    "\n",
    "    # Alinhamento correto:\n",
    "    # t-1:  0,   1,   2, ..., T-2\n",
    "    # t:    1,   2,   3, ..., T-1\n",
    "    cin_tminus1 = cin[:-1]      # cin(t-1) at indices 0...T-2\n",
    "    cout_t      = cout[1:]      # cout(t) at indices 1...T-1 (aligned with t)\n",
    "    cin_t       = cin[1:]       # cin(t) at indices 1...T-1 (target)\n",
    "\n",
    "    X = np.column_stack([cin_tminus1, cout_t])\n",
    "    y = cin_t\n",
    "    \n",
    "    # Remove NaN rows\n",
    "    valid = np.isfinite(X).all(axis=1) & np.isfinite(y)\n",
    "    if valid.sum() < 2:\n",
    "        return np.nan, np.nan\n",
    "    \n",
    "    X = X[valid]\n",
    "    y = y[valid]\n",
    "\n",
    "    try:\n",
    "        beta, *_ = np.linalg.lstsq(X, y, rcond=None)\n",
    "    except np.linalg.LinAlgError:\n",
    "        return np.nan, np.nan\n",
    "    \n",
    "    a, b = beta\n",
    "\n",
    "    # CORRECTED: Physical constraint 0 < a < 1 (decay factor)\n",
    "    if not (0 < a < 1):\n",
    "        return np.nan, np.nan\n",
    "\n",
    "    k = -np.log(a) / dt\n",
    "    Finf = b / (1 - a)\n",
    "\n",
    "    if not (np.isfinite(k) and np.isfinite(Finf)):\n",
    "        return np.nan, np.nan\n",
    "\n",
    "    return float(np.clip(Finf, 0, 1)), float(np.clip(k, 0, None))\n",
    "\n",
    "\n",
    "def block_bootstrap_indices(T: int, block_size: int, rng: np.random.Generator) -> np.ndarray:\n",
    "    \"\"\"Gera índices bootstrap por blocos contíguos para preservar estrutura temporal.\"\"\"\n",
    "    if T < block_size:\n",
    "        block_size = T\n",
    "    \n",
    "    idx = []\n",
    "    while len(idx) < T:\n",
    "        start = int(rng.integers(0, max(1, T - block_size + 1)))\n",
    "        idx.extend(range(start, min(start + block_size, T)))\n",
    "    \n",
    "    return np.array(idx[:T], dtype=int)\n",
    "\n",
    "\n",
    "def mbm_reconstruct_constant(cin: np.ndarray, cout: np.ndarray, Finf: float, k: float, dt: float = 1.0) -> np.ndarray:\n",
    "    \"\"\"Reconstrói série Cin usando MBM com parâmetros constantes.\"\"\"\n",
    "    cin = np.asarray(cin, float)\n",
    "    cout = np.asarray(cout, float)\n",
    "    T = len(cin)\n",
    "    out = np.full(T, np.nan)\n",
    "    out[0] = cin[0]\n",
    "    \n",
    "    for t in range(1, T):\n",
    "        if not (np.isfinite(cin[t-1]) and np.isfinite(cout[t])):\n",
    "            continue\n",
    "        decay = np.exp(-k*dt)\n",
    "        out[t] = cin[t-1]*decay + Finf*cout[t]*(1-decay)\n",
    "    return out\n",
    "\n",
    "\n",
    "def mbm_with_uncertainty(cin: np.ndarray, cout: np.ndarray, mask_external: np.ndarray,\n",
    "                         block_size: int = 6, n_boot: int = 200, dt: float = 1.0, seed: int = 123):\n",
    "    \"\"\"\n",
    "    Estima Finf, k' a partir de pontos externos via MBM.\n",
    "    Gera IC via bootstrap por blocos.\n",
    "    \"\"\"\n",
    "    rng = np.random.default_rng(seed)\n",
    "\n",
    "    cin = np.asarray(cin, float)\n",
    "    cout = np.asarray(cout, float)\n",
    "    mask_external = np.asarray(mask_external, bool)\n",
    "\n",
    "    valid = mask_external & np.isfinite(cin) & np.isfinite(cout)\n",
    "    cin_ext = cin[valid]\n",
    "    cout_ext = cout[valid]\n",
    "\n",
    "    if len(cin_ext) < 10:\n",
    "        cin_ext = cin[np.isfinite(cin) & np.isfinite(cout)]\n",
    "        cout_ext = cout[np.isfinite(cin) & np.isfinite(cout)]\n",
    "    \n",
    "    if len(cin_ext) < 2:\n",
    "        return {\n",
    "            \"Finf\": 0.5, \"k\": 0.1,\n",
    "            \"Finf_ci\": (0.4, 0.6), \"k_ci\": (0.05, 0.15),\n",
    "            \"cin_hat\": cin.copy(), \"cin_hat_lo\": cin.copy(), \"cin_hat_hi\": cin.copy(),\n",
    "            \"Finf_samples\": np.array([0.5]), \"k_samples\": np.array([0.1])\n",
    "        }\n",
    "\n",
    "    Finf0, k0 = estimate_params_linear(cin_ext, cout_ext, dt=dt)\n",
    "\n",
    "    Finf_s = []\n",
    "    k_s = []\n",
    "    cin_hat_s = []\n",
    "\n",
    "    for b in range(n_boot):\n",
    "        idx = block_bootstrap_indices(len(cin_ext), block_size, rng)\n",
    "        Finf_b, k_b = estimate_params_linear(cin_ext[idx], cout_ext[idx], dt=dt)\n",
    "        if np.isfinite(Finf_b) and np.isfinite(k_b):\n",
    "            Finf_s.append(Finf_b)\n",
    "            k_s.append(k_b)\n",
    "            cin_hat_s.append(mbm_reconstruct_constant(cin, cout, Finf_b, k_b, dt=dt))\n",
    "\n",
    "    Finf_s = np.array(Finf_s, float) if Finf_s else np.array([Finf0])\n",
    "    k_s = np.array(k_s, float) if k_s else np.array([k0])\n",
    "    cin_hat_s = np.array(cin_hat_s, float) if len(cin_hat_s) else np.array([cin.copy()])\n",
    "\n",
    "    def pct(a):\n",
    "        return np.nanpercentile(a, [2.5, 97.5])\n",
    "\n",
    "    Finf_ci = pct(Finf_s)\n",
    "    k_ci = pct(k_s)\n",
    "\n",
    "    cin_hat = mbm_reconstruct_constant(cin, cout, float(np.nanmean(Finf_s)), float(np.nanmean(k_s)), dt=dt)\n",
    "\n",
    "    cin_lo = np.nanpercentile(cin_hat_s, 2.5, axis=0)\n",
    "    cin_hi = np.nanpercentile(cin_hat_s, 97.5, axis=0)\n",
    "\n",
    "    return dict(\n",
    "        Finf=float(np.nanmean(Finf_s)),\n",
    "        k=float(np.nanmean(k_s)),\n",
    "        Finf_ci=Finf_ci,\n",
    "        k_ci=k_ci,\n",
    "        cin_hat=cin_hat,\n",
    "        cin_hat_lo=cin_lo,\n",
    "        cin_hat_hi=cin_hi,\n",
    "        Finf_samples=Finf_s,\n",
    "        k_samples=k_s\n",
    "    )\n",
    "\n",
    "print(\"✓ MBM functions loaded with corrected temporal alignment\")"
   ]
